# --- БЕЗОПАСНОСТЬ: личные данные и ключи в репозиторий не попадают ---
# Ключи и конфигурация окружения
.env
.env.*
!.env.example
firebase-config.js
.firebaserc
serviceAccount*.json
*.pem
*.key

# Личные данные пользователя.
# Косая черта в начале обязательна: правило без неё срабатывает на любой
# вложенной папке с таким именем, а не только в корне. Без якоря `backup/`
# исключал и src/core/backup — исходный код переставал попадать в репозиторий.
/backup/
/backups/
*.backup.json
second-brain-backup*.json
*-personal.json
/private/
/personal/

# Банковские выписки и финансовые файлы
*.csv
!src/**/fixtures/*.csv
!docs/**/*.csv
/statements/
/выписк*/

# Снимки экрана сделок и личные документы
/screenshots/
/скриншот*/
*.trade.png
